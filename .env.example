# Canonical origin used for canonical URLs, Open Graph, sitemap and robots.
# Leave unset on preview deployments; Vercel's VERCEL_PROJECT_PRODUCTION_URL is used when present,
# and http://localhost:3000 otherwise.
NEXT_PUBLIC_SITE_URL=

# Empty for a root deployment; GitHub Pages build defaults to /rivetdeck-website.
NEXT_PUBLIC_BASE_PATH=
